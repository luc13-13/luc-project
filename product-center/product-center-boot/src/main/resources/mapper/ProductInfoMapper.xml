<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lc.product.center.mapper.ProductInfoMapper">

    <!-- ==================== ResultMap ==================== -->
    <resultMap id="BaseResultMap" type="com.lc.product.center.domain.entity.ProductInfoDO">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="tenantId" column="tenant_id" jdbcType="VARCHAR"/>
        <result property="productCode" column="product_code" jdbcType="VARCHAR"/>
        <result property="subProductCode" column="sub_product_code" jdbcType="VARCHAR"/>
        <result property="billingItemCode" column="billing_item_code" jdbcType="VARCHAR"/>
        <result property="subBillingItemCode" column="sub_billing_item_code" jdbcType="VARCHAR"/>
        <result property="productName" column="product_name" jdbcType="VARCHAR"/>
        <result property="subProductName" column="sub_product_name" jdbcType="VARCHAR"/>
        <result property="billingItemName" column="billing_item_name" jdbcType="VARCHAR"/>
        <result property="subBillingItemName" column="sub_billing_item_name" jdbcType="VARCHAR"/>
        <result property="specValue" column="spec_value" jdbcType="DECIMAL"/>
        <result property="specUnit" column="spec_unit" jdbcType="VARCHAR"/>
        <result property="meteringUnit" column="metering_unit" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="sortOrder" column="sort_order" jdbcType="INTEGER"/>
        <result property="deleted" column="deleted" jdbcType="TINYINT"/>
        <result property="createdBy" column="created_by" jdbcType="VARCHAR"/>
        <result property="dtCreated" column="dt_created" jdbcType="TIMESTAMP"/>
        <result property="modifiedBy" column="modified_by" jdbcType="VARCHAR"/>
        <result property="dtModified" column="dt_modified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 通用字段列表 -->
    <sql id="Base_Column_List">
        id, tenant_id, product_code, sub_product_code, billing_item_code, sub_billing_item_code,
        product_name, sub_product_name, billing_item_name, sub_billing_item_name,
        spec_value, spec_unit, metering_unit, status, sort_order, deleted,
        created_by, dt_created, modified_by, dt_modified
    </sql>

    <!-- 动态查询条件片段 -->
    <sql id="Where_Condition">
        <where>
            deleted = 0
            <if test="dto.tenantId != null and dto.tenantId != ''">
                AND tenant_id = #{dto.tenantId, jdbcType=VARCHAR}
            </if>
            <if test="dto.id != null">
                AND id = #{dto.id, jdbcType=BIGINT}
            </if>
            <if test="dto.productCode != null and dto.productCode != ''">
                AND product_code = #{dto.productCode, jdbcType=VARCHAR}
            </if>
            <if test="dto.subProductCode != null and dto.subProductCode != ''">
                AND sub_product_code = #{dto.subProductCode, jdbcType=VARCHAR}
            </if>
            <if test="dto.billingItemCode != null and dto.billingItemCode != ''">
                AND billing_item_code = #{dto.billingItemCode, jdbcType=VARCHAR}
            </if>
            <if test="dto.subBillingItemCode != null and dto.subBillingItemCode != ''">
                AND sub_billing_item_code = #{dto.subBillingItemCode, jdbcType=VARCHAR}
            </if>
            <if test="dto.productName != null and dto.productName != ''">
                AND product_name LIKE CONCAT('%', #{dto.productName, jdbcType=VARCHAR}, '%')
            </if>
            <if test="dto.status != null and dto.status != ''">
                AND status = #{dto.status, jdbcType=VARCHAR}
            </if>
        </where>
    </sql>

    <!-- ==================== 动态条件查询（列表） ==================== -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM product_center.product_info
        <include refid="Where_Condition"/>
        ORDER BY sort_order
    </select>

    <!-- ==================== 动态条件分页查询（MyBatis-Plus IPage） ==================== -->
    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM product_center.product_info
        <include refid="Where_Condition"/>
        ORDER BY sort_order
    </select>

</mapper>
