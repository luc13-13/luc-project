<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lc.product.center.mapper.SkuPricingLinkMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.lc.product.center.domain.entity.SkuPricingLinkDO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="sku_code" property="skuCode"/>
        <result column="sku_revision" property="skuRevision"/>
        <result column="pricing_code" property="pricingCode"/>
        <result column="pricing_revision" property="pricingRevision"/>
        <result column="override_factor" property="overrideFactor"/>
        <result column="is_default" property="isDefault"/>
        <result column="status" property="status"/>
        <result column="created_by" property="createdBy"/>
        <result column="dt_created" property="dtCreated"/>
        <result column="modified_by" property="modifiedBy"/>
        <result column="dt_modified" property="dtModified"/>
    </resultMap>

    <!-- 根据SKU版本查询关联的定价 -->
    <select id="selectBySkuRevision" resultMap="BaseResultMap">
        SELECT *
        FROM product_center.sku_pricing_link
        WHERE tenant_id = #{tenantId}
          AND sku_code = #{skuCode}
          AND sku_revision = #{skuRevision}
          AND status = 'ACTIVE'
        ORDER BY is_default DESC
    </select>

    <!-- 根据SKU版本查询默认定价关联 -->
    <select id="selectDefaultBySkuRevision" resultMap="BaseResultMap">
        SELECT *
        FROM product_center.sku_pricing_link
        WHERE tenant_id = #{tenantId}
          AND sku_code = #{skuCode}
          AND sku_revision = #{skuRevision}
          AND is_default = 1
          AND status = 'ACTIVE'
        LIMIT 1
    </select>

</mapper>
